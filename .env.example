# ---------------------------------------------------------------------------------------------------
# Secrets template. Copy to `.env` (gitignored, chmod 600) and fill in. NEVER commit real values.
#   cp .env.example .env && chmod 600 .env
# The `trader` CLI and the demo contract tests read `.env` automatically; real environment variables win.
# ---------------------------------------------------------------------------------------------------

# Trading-mode guard. Must match the config's `mode`. For safety, `trader run` ignores this line in
# .env: live trading needs TRADER_MODE=live exported in the real shell AND the --confirm-live flag.
TRADER_MODE=paper

# Key that encrypts broker tokens stored at rest (data/secrets/*.tokens). Generate it with:
#   uv run trader secrets-key
# Without it, refreshed cTrader tokens are kept in memory only and lost on restart.
TRADER_SECRETS_KEY=

# --- cTrader Open API — DEMO (config: secrets_ref: CTRADER_DEMO) -----------------------------------
# 1. Create an app at https://openapi.ctrader.com/apps (wait for it to be activated).
# 2. Copy its Client ID / Secret below and add a redirect URI to the app (any URL you control;
#    you only need to copy the `code` from the browser's address bar after granting access).
# 3. Run `uv run trader ctrader-auth` — it fills in the ACCESS/REFRESH tokens below and lists
#    your ctidTraderAccountIds. Put the demo one in CTRADER_DEMO_ACCOUNT_ID and in config/demo.yaml.
CTRADER_DEMO_CLIENT_ID=
CTRADER_DEMO_CLIENT_SECRET=
CTRADER_DEMO_REDIRECT_URI=
CTRADER_DEMO_ACCESS_TOKEN=
CTRADER_DEMO_REFRESH_TOKEN=
# Not secret: numeric ctidTraderAccountId of the DEMO account used by `pytest -m demo`.
CTRADER_DEMO_ACCOUNT_ID=
# Optional: symbol for the demo contract tests (default EURUSD) and an HTTP CONNECT proxy.
CTRADER_DEMO_SYMBOL=EURUSD
CTRADER_PROXY=

# --- cTrader Open API — LIVE (secrets_ref: CTRADER_LIVE) — only on the production host ------------
# CTRADER_LIVE_CLIENT_ID=
# CTRADER_LIVE_CLIENT_SECRET=
# CTRADER_LIVE_REDIRECT_URI=
# CTRADER_LIVE_ACCESS_TOKEN=
# CTRADER_LIVE_REFRESH_TOKEN=

# --- Exness Trader API — DEMO (secrets_ref: EXNESS_DEMO) -------------------------------------------
# Exness-platform accounts only. Key Management (Personal Area): create a key with Trading -> Full access
# for ONE demo account; store the API key id and the private key; copy the Gateway host from the DNS widget.
EXNESS_DEMO_API_KEY=
# Private key: 128 hex chars (issued by Key Management) ...
EXNESS_DEMO_PRIVATE_KEY=
# ... or, for a self-generated key pair, the path to the PEM file instead (keep it chmod 600, outside the repo).
EXNESS_DEMO_PRIVATE_KEY_FILE=
# Not secret: numeric trading account id and the Gateway URL from the DNS widget (https://...).
EXNESS_DEMO_ACCOUNT_ID=
EXNESS_DEMO_GATEWAY_URL=
# Exness hosts do not separate demo from real accounts. Set to yes ONLY if the account above is a DEMO
# account. The demo tests place real (tiny) orders, and `trader run` / `trader kill` trade an
# `environment: demo` Exness account: all of them refuse to run without this.
EXNESS_DEMO_CONFIRM_DEMO_ACCOUNT=
# Optional: test symbol (default EURUSD) and the suffix your account's instruments use (e.g. m for EURUSDm).
EXNESS_DEMO_SYMBOL=EURUSD
EXNESS_DEMO_SYMBOL_SUFFIX=

# --- Exness Trader API — LIVE (secrets_ref: EXNESS_LIVE) — only on the production host ---------------
# The account id and gateway URL of a live account go in config/live.yaml (exness: block), not here.
# EXNESS_LIVE_API_KEY=
# EXNESS_LIVE_PRIVATE_KEY=
# EXNESS_LIVE_PRIVATE_KEY_FILE=

# --- Infrastructure ---------------------------------------------------------------------------------
# PostgreSQL (used when the config has a `database:` block). docker-compose.yml starts a matching local
# server; change the password. If the database is down, `trader run` keeps trading and buffers to
# data/wal/db.wal, replayed when it is back. The schema is migrated automatically on first connect.
# (Inside docker compose the app uses the postgres service instead: docker-compose.yml sets its URL.)
TRADER_DB_URL=postgresql+asyncpg://trader:change-me@localhost:5432/trader
# Control API bearer token (config `api:`), at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TRADER_API_TOKEN=

# --- Notifications (config `notify:`) ---------------------------------------------------------------
# Telegram: create a bot with @BotFather (it gives the token), send your bot any message, then read your
# chat id from https://api.telegram.org/bot<token>/getUpdates (message.chat.id). Use a PRIVATE chat:
# commands are refused from groups. `pytest -m demo tests/contract/test_telegram_probe.py` checks both.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email (optional): SMTP login; host, port and addresses go in the config.
TRADER_SMTP_USER=
TRADER_SMTP_PASSWORD=
