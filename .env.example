# Copy to .env (gitignored). Never commit real values.
# Trading mode guard: must match the config's `mode`. Live also needs --confirm-live.
TRADER_MODE=paper

# Postgres (phase 9)
TRADER_DB_URL=postgresql+asyncpg://trader:change-me@localhost:5432/trader

# cTrader Open API — DEMO (secrets_ref: CTRADER_DEMO)
CTRADER_DEMO_CLIENT_ID=
CTRADER_DEMO_CLIENT_SECRET=
CTRADER_DEMO_ACCESS_TOKEN=
CTRADER_DEMO_REFRESH_TOKEN=

# Exness Trader API — DEMO (secrets_ref: EXNESS_DEMO)
EXNESS_DEMO_API_KEY=
EXNESS_DEMO_SECRET=

# Control API (phase 10)
TRADER_API_TOKEN=
