# ---------------------------------------------------------------------------------------------------
# Secrets template. Copy to `.env` (gitignored, chmod 600) and fill in. NEVER commit real values.
#   cp .env.example .env && chmod 600 .env
# The `trader` CLI and the demo contract tests read `.env` automatically; real environment variables win.
# ---------------------------------------------------------------------------------------------------

# Trading-mode guard. Must match the config's `mode`. For safety, `trader run` ignores this line in
# .env: live trading needs TRADER_MODE=live exported in the real shell AND the --confirm-live flag.
TRADER_MODE=paper

# Key that encrypts broker tokens stored at rest (data/secrets/*.tokens). Generate it with:
#   uv run trader secrets-key
# Without it, refreshed cTrader tokens are kept in memory only and lost on restart.
TRADER_SECRETS_KEY=

# --- cTrader Open API — DEMO (config: secrets_ref: CTRADER_DEMO) -----------------------------------
# 1. Create an app at https://openapi.ctrader.com/apps (wait for it to be activated).
# 2. Copy its Client ID / Secret below and add a redirect URI to the app (any URL you control;
#    you only need to copy the `code` from the browser's address bar after granting access).
# 3. Run `uv run trader ctrader-auth` — it fills in the ACCESS/REFRESH tokens below and lists
#    your ctidTraderAccountIds. Put the demo one in CTRADER_DEMO_ACCOUNT_ID and in config/demo.yaml.
CTRADER_DEMO_CLIENT_ID=
CTRADER_DEMO_CLIENT_SECRET=
CTRADER_DEMO_REDIRECT_URI=
CTRADER_DEMO_ACCESS_TOKEN=
CTRADER_DEMO_REFRESH_TOKEN=
# Not secret: numeric ctidTraderAccountId of the DEMO account used by `pytest -m demo`.
CTRADER_DEMO_ACCOUNT_ID=
# Optional: symbol for the demo contract tests (default EURUSD) and an HTTP CONNECT proxy.
CTRADER_DEMO_SYMBOL=EURUSD
CTRADER_PROXY=

# --- cTrader Open API — LIVE (secrets_ref: CTRADER_LIVE) — only on the production host ------------
# CTRADER_LIVE_CLIENT_ID=
# CTRADER_LIVE_CLIENT_SECRET=
# CTRADER_LIVE_REDIRECT_URI=
# CTRADER_LIVE_ACCESS_TOKEN=
# CTRADER_LIVE_REFRESH_TOKEN=

# --- Exness Trader API — DEMO (secrets_ref: EXNESS_DEMO) — phase 3 ---------------------------------
EXNESS_DEMO_API_KEY=
EXNESS_DEMO_SECRET=

# --- Infrastructure (later phases) -----------------------------------------------------------------
# Postgres (phase 9)
TRADER_DB_URL=postgresql+asyncpg://trader:change-me@localhost:5432/trader
# Control API bearer token (phase 10)
TRADER_API_TOKEN=
