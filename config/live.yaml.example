# LIVE trading — real money. Copy to config/live.yaml (gitignored).
# Starts only with:  TRADER_MODE=live uv run trader run --config config/live.yaml --confirm-live
mode: live
logging:
  level: INFO
  json: true
accounts:
  - id: ctrader-live
    broker: ctrader
    environment: live
    account_id: "0000000"
    secrets_ref: CTRADER_LIVE
    symbols: [EURUSD]
    # Risk (SPEC §7, ADR 0008). These are the built-in defaults, spelled out so you see them before going
    # live. null switches a rule off; percentages are plain numbers (3 = 3 %); money is account currency.
    risk:
      day_offset_minutes: 0          # trading day starts 00:00 UTC (-120 = 22:00 UTC)
      limits:
        max_order_volume: "1"        # lots per order
        max_symbol_volume: "2"       # lots per symbol: positions + pending + this order
        max_positions_account: 10    # positions + pending entry orders
        max_positions_symbol: 3
        max_positions_strategy: 5
        max_gross_exposure: null     # money cap on sum |notional|
        max_net_exposure: null
        max_gross_leverage: "10"     # gross notional / equity
        max_net_leverage: "5"
        max_margin_usage_pct: "30"   # margin after the trade / equity
        require_sl: true             # set false only per strategy (whitelist)
        max_loss_per_trade: null     # money lost if the SL is hit
        max_loss_per_trade_pct: "1"  # of equity
        daily_loss: null             # money, from equity at the trading-day start
        daily_loss_pct: "3"
        max_drawdown_pct: "10"       # from the equity peak
        max_orders_per_minute: 20
        max_orders_per_minute_strategy: 10
        max_order_to_fill_ratio: "10"
        order_to_fill_min_orders: 20
        order_to_fill_window_min: 60
        duplicate_window_s: "10"     # same strategy + symbol + side
        max_spread_multiple: "3"     # x typical spread
        max_spread_points: {}        # e.g. {EURUSD: 20} absolute cap in ticks
        max_tick_age_s: "5"
        max_price_distance_pct: "2"  # limit/stop price vs market
        sessions:
          use_instrument_sessions: true
          weekend: ["FRI 21:00", "SUN 21:00"]   # UTC
          rollover: ["20:55", "21:10"]          # UTC, daily
          blackouts: []              # [{start: 2026-12-04T13:25:00Z, end: 2026-12-04T13:45:00Z, currencies: [USD], reason: NFP}]
      strategies: {}                 # per-strategy overrides, e.g. {scalper: {max_order_volume: "0.2"}}
      breakers:
        daily_loss_level: FLATTEN_ALL        # clears at the next trading day
        drawdown_level: FLATTEN_ALL          # latched until `trader kill --reset`
        max_consecutive_rejects: 5
        rejects_level: PAUSE_NEW             # latched
        feed_stale_s: "60"
        feed_stale_level: PAUSE_NEW          # clears when ticks resume
        disconnected_s: "60"
        disconnected_level: PAUSE_NEW        # clears on reconnect
        reconcile_kinds: [position_corrected, order_abandoned]
        reconcile_level: PAUSE_NEW           # latched
        max_clock_drift_ms: 2000
        clock_drift_level: PAUSE_NEW         # clears when back in range
